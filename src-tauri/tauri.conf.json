{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GuitarCraft",
  "version": "0.11.1",
  "identifier": "com.getartcraft.guitarcraft",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GuitarCraft",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0f0f11"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBRkE3NkY5MDBEQjNFQ0UKUldUT1B0c0ErWGI2dW8rdGNFTm1DWXZpdG02QWhnWHZnTDdodXE0eDNZZnY4NUkzOWY3QlpVcGEK",
      "endpoints": [
        "https://github.com/DimkaRapirka/GuitarCraft-Desktop/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
